<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Small console app that is published with Native AOT to verify the libraries work without runtime code generation.
		Start Azurite, then: dotnet publish -c Release -r win-x64, and run the native executable.
		Optionally pass a connection string as the first argument.
	-->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFrameworks></TargetFrameworks>
		<TargetFramework>net10.0</TargetFramework>
		<PublishAot>true</PublishAot>
		<IsPackable>false</IsPackable>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<RootNamespace>TableStorage.AotSample</RootNamespace>
		<!-- These are normally added by the props files in the NuGet packages -->
		<DefineConstants>$(DefineConstants);TABLESTORAGE;TABLESTORAGE_BLOBS</DefineConstants>
		<!-- Azure.Data.Tables itself isn't annotated for AOT; keep those warnings visible without failing the publish -->
		<WarningsNotAsErrors>$(WarningsNotAsErrors);IL2104;IL3053</WarningsNotAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<CompilerVisibleProperty Include="PublishAot" />
		<CompilerVisibleProperty Include="TableStorageSerializerContext" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\TableStorage\TableStorage.csproj" />
		<ProjectReference Include="..\TableStorage.Blobs\TableStorage.Blobs.csproj" />
		<ProjectReference Include="..\TableStorage.Fluent\TableStorage.Fluent.csproj" />
		<ProjectReference Include="..\TableStorage.SourceGenerators\TableStorage.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>
</Project>
