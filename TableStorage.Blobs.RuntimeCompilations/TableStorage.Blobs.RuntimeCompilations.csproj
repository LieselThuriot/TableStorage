<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<GeneratePackageOnBuild Condition="$(Configuration) == 'Release'">True</GeneratePackageOnBuild>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>TableStorage.png</PackageIcon>
		<RootNamespace>TableStorage</RootNamespace>
		<VersionPrefix>$(MajorMinorVersion).$(BuildVersion)</VersionPrefix>
	</PropertyGroup>
	
	<ItemGroup>
		<None Include="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="TableStorage.png">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="TableStorage.Blobs.props" Pack="true" PackagePath="build\TableStorage.Blobs.RuntimeCompilations.props" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="FastExpressionCompiler" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\TableStorage.Blobs\TableStorage.Blobs.csproj" PackageVersion="[^,$)" />
	</ItemGroup>
</Project>
