<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>TableStorage</RootNamespace>
		<GeneratePackageOnBuild Condition="$(Configuration) == 'Release'">True</GeneratePackageOnBuild>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>TableStorage.png</PackageIcon>
		<VersionPrefix>$(MajorMinorVersion).$(BuildVersion)</VersionPrefix>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		
		<None Include="TableStorage.png">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>

		<None Include="$(MSBuildThisFileDirectory)..\TableStorage.SourceGenerators\bin\$(Configuration)\netstandard2.0\TableStorage.SourceGenerators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />

		<None Include="TableStorage.Core.props" Pack="true" PackagePath="build\TableStorage.Core.props" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="TableStorage" />
		<InternalsVisibleTo Include="TableStorage.RuntimeCompilations" />
		<InternalsVisibleTo Include="TableStorage.Fluent" />
		<InternalsVisibleTo Include="TableStorage.Fluent.Extended" />
		<InternalsVisibleTo Include="TableStorage.Blobs" />
		<InternalsVisibleTo Include="TableStorage.Blobs.RuntimeCompilations" />
		<InternalsVisibleTo Include="TableStorage.Tests" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETStandard'">
		<PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
	</ItemGroup>
</Project>
