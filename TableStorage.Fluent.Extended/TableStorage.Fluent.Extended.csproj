<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
    <GeneratePackageOnBuild Condition="$(Configuration) == 'Release'">True</GeneratePackageOnBuild>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>TableStorage.png</PackageIcon>
    <VersionPrefix>$(MajorMinorVersion).$(BuildVersion)</VersionPrefix>
  </PropertyGroup>

  <ItemGroup>
	<ProjectReference Include="..\TableStorage\TableStorage.csproj" PackageVersion="[^,$)" />
    <ProjectReference Include="..\TableStorage.Fluent\TableStorage.Fluent.csproj" PackageVersion="[^,$)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="TableStorage.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="TableStorage.props" Pack="true" PackagePath="build\TableStorage.Fluent.Extended.props" />
    <Using Include="Azure" />
    <Using Include="Azure.Data.Tables" />
  </ItemGroup>

  <ItemGroup>
    <Service Include="{508349b6-6b84-4df5-91f0-309beebad82d}" />
  </ItemGroup>

  <!-- Runs once before the inner builds when multi-targeting; skipped by the inner builds when the output is up to date -->
  <Target Name="TextTemplateTransform" BeforeTargets="DispatchToInnerBuilds;BeforeBuild" Inputs="..\TableStorage.Fluent\FluentTableEntity.tt;..\TableStorage.Fluent\Linq\FluentTableQueryHelper.tt" Outputs="FluentTableEntity.g.cs;FluentTableQueryHelper.g.cs">
    <Exec WorkingDirectory="$(ProjectDir)" Command="dotnet t4 ..\TableStorage.Fluent\FluentTableEntity.tt -p ExtendedClasses=true -o FluentTableEntity" />
    <Exec WorkingDirectory="$(ProjectDir)" Command="dotnet t4 ..\TableStorage.Fluent\Linq\FluentTableQueryHelper.tt -p ExtendedClasses=true -o FluentTableQueryHelper" />
  </Target>

</Project>