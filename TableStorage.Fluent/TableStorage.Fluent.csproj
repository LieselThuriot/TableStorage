<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
		<GeneratePackageOnBuild Condition="$(Configuration) == 'Release'">True</GeneratePackageOnBuild>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>TableStorage.png</PackageIcon>
		<VersionPrefix>$(MajorMinorVersion).$(BuildVersion)</VersionPrefix>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\TableStorage\TableStorage.csproj" PackageVersion="[^,$)" />
		<!-- Only referenced for build ordering; the generator runs in the consuming projects -->
		<ProjectReference Include="..\TableStorage.Fluent.SourceGenerators\TableStorage.Fluent.SourceGenerators.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="TableStorage.Tests" />
		<InternalsVisibleTo Include="TableStorage.Fluent.RuntimeCompilations" />
		<None Include="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="TableStorage.png">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="TableStorage.props" Pack="true" PackagePath="build\TableStorage.Fluent.props" />
		<None Include="$(MSBuildThisFileDirectory)..\TableStorage.Fluent.SourceGenerators\bin\$(Configuration)\netstandard2.0\TableStorage.Fluent.SourceGenerators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
		<Using Include="Azure" />
		<Using Include="Azure.Data.Tables" />
	</ItemGroup>
</Project>