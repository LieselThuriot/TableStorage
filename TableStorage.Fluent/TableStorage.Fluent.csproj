<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
		<GeneratePackageOnBuild Condition="$(Configuration) == 'Release'">True</GeneratePackageOnBuild>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>TableStorage.png</PackageIcon>
		<VersionPrefix>$(MajorMinorVersion).$(BuildVersion)</VersionPrefix>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\TableStorage\TableStorage.csproj" PackageVersion="[^,$)" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="TableStorage.Tests" />
		<InternalsVisibleTo Include="TableStorage.Fluent.Extended" />
		<InternalsVisibleTo Include="TableStorage.Fluent.RuntimeCompilations" />
		<None Include="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="TableStorage.png">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="TableStorage.props" Pack="true" PackagePath="build\TableStorage.Fluent.props" />
		<Using Include="Azure" />
		<Using Include="Azure.Data.Tables" />
	</ItemGroup>

	<!-- Runs once before the inner builds when multi-targeting; skipped by the inner builds when the output is up to date -->
	<Target Name="TextTemplateTransform" BeforeTargets="DispatchToInnerBuilds;BeforeBuild" Inputs="FluentTableEntity.tt;Linq\FluentTableQueryHelper.tt" Outputs="FluentTableEntity.g.cs;Linq\FluentTableQueryHelper.g.cs">
		<Exec WorkingDirectory="$(ProjectDir)" Command="dotnet t4 .\FluentTableEntity.tt -p ExtendedClasses=false" />
		<Exec WorkingDirectory="$(ProjectDir)" Command="dotnet t4 .\Linq\FluentTableQueryHelper.tt -p ExtendedClasses=false" />
	</Target>
</Project>